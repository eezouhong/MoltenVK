+static nir_variable *
+add_runtime_srv_var(nir_shader *nir, unsigned desc_set, unsigned binding)
+{
+   const unsigned words = nir->info.stage == MESA_SHADER_COMPUTE ? 3 : 2;
+   const struct glsl_type *array = glsl_array_type(glsl_uint_type(), words, sizeof(unsigned));
+   const struct glsl_struct_field field = {array, "arr"};
+   nir_variable *var = nir_variable_create(nir, nir_var_mem_ssbo,
+      glsl_struct_type(&field, 1, "runtime_raw", false), "runtime_raw");
+   var->data.descriptor_set = desc_set;
+   assert(var->data.descriptor_set == desc_set);
+   var->data.binding = binding;
+   var->data.access = ACCESS_NON_WRITEABLE;
+   var->data.how_declared = nir_var_hidden;
+   return var;
+}
+
+static bool
+runtime_buffer_is_live(nir_shader *nir, unsigned desc_set, unsigned binding)
+{
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic) continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic == nir_intrinsic_vulkan_resource_index &&
+                nir_intrinsic_desc_set(intr) == desc_set && nir_intrinsic_binding(intr) == binding)
+               return true;
+         }
+      }
+   }
+   return false;
+}
