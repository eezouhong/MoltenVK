+/* Bridge extension: transport native point I/O as explicitly named DXIL
+ * varyings. The consumer must restore their rasterizer semantics in AIR;
+ * ordinary D3D12 and Vulkan bridge entry points never enable this path. */
+static bool
+prepare_native_point_io(nir_shader *nir, uint32_t *native_io)
+{
+   if (nir->info.stage != MESA_SHADER_VERTEX &&
+       nir->info.stage != MESA_SHADER_FRAGMENT)
+      return true;
+
+   if (nir->info.stage == MESA_SHADER_FRAGMENT) {
+      const struct nir_lower_sysvals_to_varyings_options options = {.point_coord = true};
+      NIR_PASS(_, nir, nir_lower_sysvals_to_varyings, &options);
+   }
+   nir_variable_mode mode = nir->info.stage == MESA_SHADER_VERTEX
+      ? nir_var_shader_out : nir_var_shader_in;
+   unsigned builtin = nir->info.stage == MESA_SHADER_VERTEX
+      ? VARYING_SLOT_PSIZ : VARYING_SLOT_PNTC;
+   nir_variable *point = NULL;
+   uint64_t occupied = 0;
+   nir_foreach_variable_with_modes(var, nir, mode) {
+      if (var->data.location == builtin)
+         point = var;
+      else if (var->data.location >= VARYING_SLOT_VAR0 &&
+               var->data.location < VARYING_SLOT_VAR0 + 32) {
+         unsigned slots = glsl_count_attribute_slots(var->type, false);
+         if (slots > 32 - (var->data.location - VARYING_SLOT_VAR0))
+            return false;
+         for (unsigned i = 0; i < slots; ++i)
+            occupied |= BITFIELD64_BIT(var->data.location - VARYING_SLOT_VAR0 + i);
+      }
+   }
+   if (!point)
+      return true;
+   bool used = false;
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            nir_intrinsic_op op = mode == nir_var_shader_out
+               ? nir_intrinsic_store_deref : nir_intrinsic_load_deref;
+            if (intr->intrinsic == op && nir_intrinsic_get_var(intr, 0) == point)
