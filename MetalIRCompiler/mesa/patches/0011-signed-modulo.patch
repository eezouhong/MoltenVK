 static bool
+emit_imod(struct ntd_context *ctx, nir_alu_instr *alu,
+          const struct dxil_value *dividend, const struct dxil_value *divisor)
+{
+   /* OpSMod has the divisor's sign; DXIL srem has the dividend's sign.
+    * Correct only nonzero remainders with opposite signs. In particular,
+    * an exact division with operands of different signs must still yield 0.
+    */
+   const struct dxil_value *remainder =
+      dxil_emit_binop(&ctx->mod, DXIL_BINOP_SREM, dividend, divisor, 0);
+   const struct dxil_value *zero =
+      dxil_module_get_int_const(&ctx->mod, 0, alu->def.bit_size);
+   if (!remainder || !zero)
+      return false;
+   const struct dxil_value *signs =
+      dxil_emit_binop(&ctx->mod, DXIL_BINOP_XOR, remainder, divisor, 0);
+   const struct dxil_value *nonzero =
+      dxil_emit_cmp(&ctx->mod, DXIL_ICMP_NE, remainder, zero);
+   if (!signs || !nonzero)
+      return false;
+   const struct dxil_value *opposite =
+      dxil_emit_cmp(&ctx->mod, DXIL_ICMP_SLT, signs, zero);
+   if (!opposite)
+      return false;
+   const struct dxil_value *adjust =
+      dxil_emit_binop(&ctx->mod, DXIL_BINOP_AND, nonzero, opposite, 0);
+   if (!adjust)
+      return false;
+   const struct dxil_value *bias =
+      dxil_emit_select(&ctx->mod, adjust, divisor, zero);
+   if (!bias)
+      return false;
+   return emit_binop(ctx, alu, DXIL_BINOP_ADD, remainder, bias);
+}
