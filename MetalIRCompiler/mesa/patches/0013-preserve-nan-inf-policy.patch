-      if (ctx->opts->relaxed_math_refactoring)
+   if (is_float_op && ctx->opts->relaxed_math_refactoring) {
+      /* The NaN/Inf policy sets no_transform on every float op, so only the
+       * contraction and reassociation bits keep a Relaxed op exact.
+       */
+      if (!(alu->fp_math_ctrl & (nir_fp_no_contract | nir_fp_no_reassoc)))
          flags |= DXIL_NO_SIGNED_ZEROS | DXIL_ALLOW_RECIPROCAL;
-      else if (!ctx->opts->disable_math_refactoring)
-         flags |= DXIL_UNSAFE_ALGEBRA;
+   } else if (is_float_op && !nir_alu_instr_is_exact(alu) &&
+              !ctx->opts->disable_math_refactoring) {
+      flags |= DXIL_UNSAFE_ALGEBRA;
    }
 
    const struct dxil_value *v = dxil_emit_binop(&ctx->mod, opcode, op0, op1, flags);
