#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x=1) in;
layout(triangles, max_vertices=3, max_primitives=1) out;
layout(set=0,binding=0,std430) buffer Output { uvec4 rows[]; } data;
void main() {
    SetMeshOutputsEXT(3,1);
    vec2 p[3]=vec2[3](vec2(-1,-1),vec2(3,-1),vec2(-1,3));
    for(uint i=0;i<3;++i)gl_MeshVerticesEXT[i].gl_Position=vec4(p[i],0,1);
    gl_PrimitiveTriangleIndicesEXT[0]=uvec3(0,1,2);
    uint index=gl_WorkGroupID.x;
    atomicExchange(data.rows[index].x,31u);
    atomicExchange(data.rows[index].y,41u);
    atomicExchange(data.rows[index].z,59u);
    atomicExchange(data.rows[index].w,26u);
}
