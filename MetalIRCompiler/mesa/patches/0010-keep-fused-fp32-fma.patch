--- a/src/microsoft/compiler/nir_to_dxil.c
+++ b/src/microsoft/compiler/nir_to_dxil.c
@@ -92,6 +92,10 @@ nir_options = {
    .compact_arrays = true,
    .lower_ineg = true,
    .lower_fneg = true,
+   /* Keep source fp32 fma as one fused operation instead of splitting it
+    * into a multiply and add that a later contraction may regroup.
+    */
+   .float_mul_add32 = nir_float_muladd_support_keep_weak_ffma,
    .float_mul_add64 = nir_float_muladd_support_has_ffma,
    .lower_isign = true,
    .lower_fsign = true,
@@ -289,6 +293,7 @@ enum dxil_intr {
    DXIL_INTR_UMAX = 39,
    DXIL_INTR_UMIN = 40,
 
+   DXIL_INTR_FMAD = 46,
    DXIL_INTR_FMA = 47,
 
    DXIL_INTR_IBFE = 51,
@@ -3114,6 +3119,9 @@ emit_alu(struct ntd_context *ctx, nir_alu_instr *alu)
    case nir_op_fsqrt: return emit_unary_intin(ctx, alu, DXIL_INTR_SQRT, src[0]);
    case nir_op_fmax: return emit_binary_intin(ctx, alu, DXIL_INTR_FMAX, src[0], src[1]);
    case nir_op_fmin: return emit_binary_intin(ctx, alu, DXIL_INTR_FMIN, src[0], src[1]);
+   case nir_op_ffma_weak:
+      assert(alu->def.bit_size == 32);
+      return emit_tertiary_intin(ctx, alu, DXIL_INTR_FMAD, src[0], src[1], src[2]);
    case nir_op_ffma:
       if (alu->def.bit_size == 64)
          ctx->mod.feats.dx11_1_double_extensions = 1;
