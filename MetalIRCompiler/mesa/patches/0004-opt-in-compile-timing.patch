 static_assert((mesa_shader_stage)DXIL_SPIRV_SHADER_KERNEL == MESA_SHADER_KERNEL, "must match");
+
+// Local timing is opt-in and emitted once per compilation region, not per NIR pass.
+static uint64_t replay_clock(clockid_t kind) {
+   struct timespec value;
+   return clock_gettime(kind, &value) == 0 ? (uint64_t)value.tv_sec * 1000000000 + value.tv_nsec : 0;
+}
+static void replay_phase(const char *region, dxil_spirv_shader_stage stage,
+                         uint64_t wall, uint64_t cpu) {
+   if (!wall) return;
+   uint64_t end_cpu = replay_clock(CLOCK_THREAD_CPUTIME_ID);
+   fprintf(stderr, "MESA_REPLAY_PHASE region=%s stage=%u wall_ns=%llu thread_cpu_ns=%llu cpu_valid=%u\n",
+           region, stage, (unsigned long long)(replay_clock(CLOCK_MONOTONIC) - wall),
+           (unsigned long long)(cpu && end_cpu >= cpu ? end_cpu - cpu : 0), cpu && end_cpu >= cpu);
+}
 
