+         index ? "melonx_native_instance_id" : "melonx_native_vertex_id");
+      state->inputs[index]->data.location = VERT_ATTRIB_GENERIC0 + state->locations[index];
+      state->inputs[index]->data.how_declared = nir_var_hidden;
